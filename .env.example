# ── Control Plane ─────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://simforge:simforge_dev_secret@localhost:5432/simforge
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────
JOB_SIGNING_SECRET=change_this_to_a_random_string_minimum_32_characters

# ── Observability ─────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=simforge-control-plane

# ── Worker ────────────────────────────────────────────
WORKER_ID=worker-1
WORKER_REGION=local
MAX_CONCURRENT_AGENTS=1000
WORKER_CONCURRENCY=10
GLOBAL_RPS_CAP=500

JWT_SECRET=simforge_jwt_secret_change_in_production_minimum_32_chars
